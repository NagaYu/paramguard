{
  "name": "paramguard",
  "version": "1.0.0",
  "description": "Detect when UTM (and other tracking) parameters silently vanish across redirects and in-page navigations — stop wasting ad spend on broken attribution.",
  "keywords": [
    "utm",
    "utm-parameters",
    "marketing",
    "attribution",
    "ad-spend",
    "playwright",
    "redirect",
    "qa",
    "cli",
    "growth",
    "analytics",
    "tracking"
  ],
  "license": "MIT",
  "author": "ParamGuard Contributors",
  "homepage": "https://github.com/NagaYu/paramguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NagaYu/paramguard.git"
  },
  "bugs": {
    "url": "https://github.com/NagaYu/paramguard/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "paramguard": "dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "colorette": "^2.0.20",
    "commander": "^12.1.0",
    "playwright": "^1.47.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
